{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scoreeasy",
  // Same Cloudflare account as Zwapit. Verify in the dashboard if scoreeasy lives
  // in a different account, and update this id (or move it to a CLOUDFLARE_ACCOUNT_ID
  // secret consumed by the workflow).
  "account_id": "3216bc4d5cf3736883b6976853d59a4c",
  "compatibility_date": "2026-06-25",
  "workers_dev": true,
  "preview_urls": true,
  // Worker entry: redirects plain http to https and adds HSTS, then hands every
  // request to the static assets below (see worker/index.js).
  "main": "worker/index.js",
  // Serve the Vite SPA build from ./dist.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker on every request (not only asset misses) so the http
    // redirect also covers requests that match a static file.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    // SPA fallback — serve index.html (200) for any unmatched client route
    // (/live/:token, /history, …). Replaces the old vercel.json rewrite.
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
