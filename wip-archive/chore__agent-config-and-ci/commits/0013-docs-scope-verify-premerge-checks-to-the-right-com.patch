   "description": "Score Easy - universal sports scorecard platform for any game",
   "type": "module",
+  "packageManager": "bun@1.3.13",
+  "engines": {
+    "bun": ">=1.2.15"
+  },
   "scripts": {
     "dev": "vite",
     "build": "vite build",
