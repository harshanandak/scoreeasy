From 1f33cd4ab69d22ec7bd26277bcd9e4a3aee2b219 Mon Sep 17 00:00:00 2001
From: harshanandak <harshanandak@users.noreply.github.com>
Date: Mon, 29 Jun 2026 00:23:38 +0530
Subject: [PATCH] fix(quick-match): resolve adversarial-review findings on the
 hardening PR (#106)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

From the multi-agent review of #124:
- HIGH: a no-draw timed match tied 0-0 at full time was a dead end (scoring locked,
  no undo history, can't end on a tie). Add a deciding-score exception: when the
  clock is up AND the sport can't draw AND the score is tied, keep the scoring
  controls live for exactly the one goal that breaks the tie (scoringLocked encodes
  this); the end prompt then opens once the match is endable.
- a11y: ScoringStatusStrip always renders its polite live region (even empty) so the
  FIRST action is announced — a live region must exist before its content changes.
- a11y: the goals score-display half gets the .mono-arena-half-display modifier so it
  reads as non-interactive (correct cursor/press affordance).

Regression test: a no-draw timed match (basketball) at 0-0 time-up can still score
the deciding point and then becomes endable.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 .../MonoQuickMatch.hardening.test.jsx         | 26 ++++++++++
 src/designs/design1-mono/MonoQuickMatch.jsx   | 52 ++++++++++++-------
 2 files changed, 58 insertions(+), 20 deletions(-)

diff --git a/src/designs/design1-mono/MonoQuickMatch.hardening.test.jsx b/src/designs/design1-mono/MonoQuickMatch.hardening.test.jsx
index c7cfcc8..8967461 100644
--- a/src/designs/design1-mono/MonoQuickMatch.hardening.test.jsx
+++ b/src/designs/design1-mono/MonoQuickMatch.hardening.test.jsx
@@ -136,6 +136,32 @@ describe('MonoQuickMatch hardening (#106)', () => {
     expect(screen.getByRole('button', { name: 'Add 1 to Reds' })).toBeDisabled();
   });
 
+  it('lets a no-draw timed match score the deciding point at full time (no 0-0 dead end)', () => {
+    // basketball: drawAllowed=false. Tied 0-0 at time-up would otherwise be a dead
+    // end (can't score, no undo history, can't end on a tie) — the deciding-score
+    // lever must stay live.
+    ctx.sport = 'basketball';
+    ctx.draft = {
+      ...base,
+      sport: 'basketball',
+      quickMatchId: 7007,
+      gScore1: 0,
+      gScore2: 0,
+      gScoreHistory: [],
+      format: { mode: 'timed', timeLimit: 60 },
+      timerElapsed: 60,
+    };
+    render(<MonoQuickMatch />);
+
+    // The deciding-score control is still enabled at 0-0 time-up.
+    const plusOne = screen.getAllByRole('button', { name: '+1' })[0];
+    expect(plusOne).toBeEnabled();
+    fireEvent.click(plusOne);
+
+    // Now untied (1-0): the match becomes endable and the end prompt appears.
+    expect(screen.getByRole('dialog', { name: /End match/i })).toBeInTheDocument();
+  });
+
   it('announces the last scoring action in an aria-live region inside the scorer', () => {
     seedVolleyball({ lastAction: 'Reds +1' });
     render(<MonoQuickMatch />);
