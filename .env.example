# Client-side Vite variables.
# Sign-in stays inactive locally until BOTH of the next two are set (Clerk supports separate dev/prod instances).
# Use the Clerk development publishable key for Vercel Preview deployments.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_<development-clerk-publishable-key>
VITE_CONVEX_URL=https://<development-convex-deployment>.convex.cloud

# Optional client error reporting.
VITE_SENTRY_DSN=

# Convex server env, not a Vite client env:
# CLERK_JWT_ISSUER_DOMAIN=https://elegant-seahorse-53.clerk.accounts.dev
