    "mobile:android": "vite build && cap sync android",
    "mobile:ios": "vite build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "8.3.4",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.3.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.3.4",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@clerk/clerk-react": "5.61.6",
    "@sentry/react": "^10.53.1",
    "convex": "^1.38.0",
    "convex-helpers": "^0.1.116",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@capacitor/cli": "8.3.4",
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "postcss": "8.5.14",
    "react-grab": "^0.1.34",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "6.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "brace-expansion": "5.0.6",
    "fast-uri": "3.1.2",
    "js-cookie": "3.0.7",
    "picomatch": "4.0.4",
    "postcss": "8.5.14",
    "rollup": "4.60.3",
    "vite": "6.4.2",
    "ws": "8.20.1"
