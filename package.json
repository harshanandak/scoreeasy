{
  "name": "score-easy",
  "version": "1.0.0",
  "description": "Score Easy - universal sports scorecard platform for any game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "sync:agents": "node scripts/sync-agent-config.mjs",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "mobile:build": "vite build && cap sync",
