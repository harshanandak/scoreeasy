{
  "name": "score-easy",
  "version": "1.0.0",
  "description": "Score Easy - universal sports scorecard platform for any game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "mobile:build": "vite build && cap sync",
    "mobile:sync": "cap sync",
    "mobile:android": "vite build && cap sync android",
    "mobile:ios": "vite build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@clerk/clerk-react": "^5.61.1",
    "@sentry/react": "^10.20.0",
    "convex": "^1.32.0",
    "convex-helpers": "^0.1.113",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "react-grab": "^0.1.13",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.0.18"
  },
  "scoreEasy": {
    "sentryEnvVar": "VITE_SENTRY_DSN"
  }
}
